# SafeHaul Environment Configuration Example
# Copy this file to .env and supply your secrets / credentials

# ==============================================================================
# Backend Configuration (Django)
# ==============================================================================
DEBUG=True
SECRET_KEY=django-insecure-replace-with-a-random-secret-key-at-least-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.local

# Database Configuration
# Leave empty to use local SQLite (default), or provide postgresql URL:
# DATABASE_URL=postgresql://user:password@localhost:5432/safehaul
DATABASE_URL=

# Cache / Redis Configuration
# Leave empty to use in-memory LocMemCache (default for zero-setup local dev),
# or provide an Upstash / local Redis URL:
# REDIS_URL=rediss://default:token@your-upstash-endpoint.upstash.io:6379
REDIS_URL=

# CORS Configuration (comma-separated origins allowed to access the API)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Route Caching Toggle
# Kept False by default until Mapbox Directions caching terms are confirmed
ENABLE_ROUTE_CACHE=False

# External API Tokens
# Obtain a public token at https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# Rate Limits / Throttling
DRF_THROTTLE_ANON_ANALYZE=60/min
DRF_THROTTLE_ANON_GEOCODE=120/min

# ==============================================================================
# Frontend Configuration (Vite)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8000
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
